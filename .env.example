# Copy thành .env và thay placeholder bằng key của bạn. Không commit .env.
# OpenRouter: https://openrouter.ai/settings/keys
OPENAI_API_KEY=your-openrouter-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LAB_MODEL=nex-agi/nex-n2.5-pro:free
LAB_MINI_MODEL=nex-agi/nex-n2.5-mini:free
# Tắt reasoning cho thí nghiệm temperature và câu trả lời ngắn trong lab.
LAB_REASONING_EFFORT=none

# Nếu dùng OpenAI trực tiếp: thay key, xóa OPENAI_BASE_URL và
# LAB_REASONING_EFFORT, đặt LAB_MODEL=gpt-4o, LAB_MINI_MODEL=gpt-4o-mini.
# Free endpoint có thể bị giới hạn; xem SOLUTION_NOTES.md.
